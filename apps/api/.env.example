APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://deploycore:deploycore@localhost:5432/deploycore?sslmode=disable
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_TOKEN_SECRET=dev-only-change-me-deploycore-auth-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_PASSWORD_RESET_TTL=1h
AUTH_RATE_LIMIT_PER_MINUTE=30
AGENT_REGISTRATION_TOKEN_TTL=15m
AGENT_HEARTBEAT_RETAIN_COUNT=50
PUBLIC_RATE_LIMIT_PER_MINUTE=30
GIT_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576
READ_TIMEOUT=30s
WRITE_TIMEOUT=60s
IDLE_TIMEOUT=120s
